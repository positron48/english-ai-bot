# Конфигурация Nginx для English Bot
# Скопируйте в /etc/nginx/sites-available/english.positroid.tech
# и создайте симлинк: ln -s /etc/nginx/sites-available/english.positroid.tech /etc/nginx/sites-enabled/

# Основной сервер для домена бота
server {
    server_name english.positroid.tech;

    # Логи
    access_log /var/log/nginx/english.positroid.tech-access.log;
    error_log /var/log/nginx/english.positroid.tech-error.log;

    # Webhook endpoint для Telegram
    location /webhook {
        proxy_pass http://127.0.0.1:8184/webhook;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Таймауты для Telegram API
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        # Дополнительные заголовки для Telegram
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Port $server_port;
    }

    # API endpoints - all API calls go to /api/*
    location /api {
        proxy_pass http://127.0.0.1:8184;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Для WebSocket (если понадобится в будущем)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Web Application (Vue SPA)
    # The frontend is embedded in the Go binary and served at /app
    # UI routes use history mode: /app/dashboard, /app/vocab, etc.
    # All /app/* routes are handled by the Go backend which serves index.html for SPA routing
    location /app {
        proxy_pass http://127.0.0.1:8184;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Для WebSocket (если понадобится в будущем)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Swagger API documentation
    location /swagger {
        proxy_pass http://127.0.0.1:8184;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Авторизация и логин
    location ~ ^/(login|auth) {
        proxy_pass http://127.0.0.1:8184;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Статус сервиса
    location /health {
        proxy_pass http://127.0.0.1:8184/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Редирект корневого пути на Web App
    location = / {
        return 301 /app;
    }

    # Запрет доступа к скрытым файлам
    location ~ /\. {
        deny all;
    }

    # SSL настройки будут добавлены автоматически certbot
    listen 80;
}

