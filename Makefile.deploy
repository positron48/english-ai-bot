# Deployment Makefile for Universal AI Bot
# This Makefile is a wrapper around scripts/deploy.sh
# All deployment logic is in deploy.sh to avoid code duplication

# Default values - can be overridden via .env or environment variables
GITHUB_REPO ?= positron48/english-ai-bot
APP_NAME ?= universal-ai-bot

# Load variables from .env file
ifneq (,$(wildcard .env))
    include .env
    export
endif
SERVICE_NAME ?= ai-bot

.PHONY: FORCE deploy update status logs restart stop start help

FORCE:

# Download and install binary
deploy:
	@if [ -f deploy.sh ]; then \
		chmod +x deploy.sh; \
		GITHUB_REPO=$(GITHUB_REPO) APP_NAME=$(APP_NAME) SERVICE_NAME=$(SERVICE_NAME) ./deploy.sh deploy; \
	elif [ -f scripts/deploy.sh ]; then \
		chmod +x scripts/deploy.sh; \
		GITHUB_REPO=$(GITHUB_REPO) APP_NAME=$(APP_NAME) SERVICE_NAME=$(SERVICE_NAME) ./scripts/deploy.sh deploy; \
	else \
		echo "Error: deploy.sh not found. Run setup first."; \
		exit 1; \
	fi

update:
	@if [ -f deploy.sh ]; then \
		chmod +x deploy.sh; \
		GITHUB_REPO=$(GITHUB_REPO) APP_NAME=$(APP_NAME) SERVICE_NAME=$(SERVICE_NAME) ./deploy.sh update; \
	elif [ -f scripts/deploy.sh ]; then \
		chmod +x scripts/deploy.sh; \
		GITHUB_REPO=$(GITHUB_REPO) APP_NAME=$(APP_NAME) SERVICE_NAME=$(SERVICE_NAME) ./scripts/deploy.sh update; \
	else \
		echo "Error: deploy.sh not found. Run setup first."; \
		exit 1; \
	fi

status:
	@systemctl --user status $(SERVICE_NAME)

logs: FORCE
	@journalctl --user -u $(SERVICE_NAME) -f

restart:
	@systemctl --user restart $(SERVICE_NAME)

stop:
	@systemctl --user stop $(SERVICE_NAME)

start:
	@systemctl --user start $(SERVICE_NAME)

help:
	@echo "Available commands:"
	@echo "  make deploy  - Deploy/update the bot"
	@echo "  make update  - Update to latest version"
	@echo "  make status  - Check service status"
	@echo "  make logs    - View service logs"
	@echo "  make restart - Restart service"
	@echo "  make stop    - Stop service"
	@echo "  make start   - Start service"
	@echo "  make help    - Show this help"
