# ComfyUI Desktop (reading cover images). Copy vars into .env:
#   cat env.example.comfy >> .env

COMFYUI_URL=http://127.0.0.1:8000
COMFYUI_WORKFLOW=/absolute/path/to/english-ai-bot/scripts/comfyui/reading-cover-z-image-turbo.workflow.json

# Optional: legacy SD1.5 workflow only
# COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors

# Test without LLM:
# READING_COVER_PROMPT_MOCK=1

# qwen3 cover JSON (reasoning uses budget before content):
# READING_COVER_MAX_TOKENS=4096
