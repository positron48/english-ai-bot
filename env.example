# Service Configuration
SERVICE_NAME=ai-bot

# Language pair / multilang profile (defaults match current English RU→EN instance)
# LEARNING_PAIR must equal ${LEARNING_NATIVE_LANG}-${LEARNING_TARGET_LANG} (lowercase codes).
LEARNING_PAIR=ru-en
LEARNING_NATIVE_LANG=ru
LEARNING_TARGET_LANG=en
# Logical app id for this deployment (e.g. english | spanish).
LEARNING_APP_CODE=english
# Embedded / selected grammar bundle id (target-language bundle): en | es (or custom via GRAMMAR_BUNDLE_DIR).
GRAMMAR_BUNDLE_ID=en
# Optional: filesystem root with sections.json / index.json / chapters/ (overrides embedded bundle for GRAMMAR_BUNDLE_ID).
# GRAMMAR_BUNDLE_DIR=
# Runtime content source: bundle (current default) or db (after import_learning_content --commit).
CONTENT_SOURCE=bundle

# GitHub Configuration (for private repositories)
# GITHUB_TOKEN=your_github_personal_access_token_here

# Telegram Bot Configuration
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_API_BASE_URL=
TELEGRAM_SOCKS5_PROXY_ADDR=
TELEGRAM_DEBUG=false
TELEGRAM_UPDATES_TIMEOUT=30

# Webhook Configuration (optional)
TELEGRAM_WEBHOOK_ENABLE=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_DOMAIN=https://your-domain.com
TELEGRAM_WEBHOOK_PATH=/webhook

# Server Configuration
SERVER_ADDRESS=:8080
SERVER_PORT=8080

# Logging Configuration
LOG_LEVEL=info

# Database Configuration
DATABASE_DRIVER=postgres
DATABASE_PATH=./data/words.db
# For local dev: start Postgres with 'make postgres-up', then use:
# DATABASE_URL=postgres://english:english@127.0.0.1:5433/english?sslmode=disable
# DATABASE_URL=postgres://user:password@postgres:5432/english?sslmode=disable

# AI Provider Configuration
AI_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3-coder:free
AI_MODEL_HIGH=openai/gpt-5-mini
AI_API_KEY=your_openrouter_api_key_here

# Pronunciation / TTS Configuration
TTS_ENABLED=true
# auto | dictionary | openrouter | external
TTS_PROVIDER=auto
TTS_EXTERNAL_ONLY=false
# Cache directory inside container/pod
TTS_AUDIO_DIR=/app/data/tts
# Public URL prefix used by browser to play cached files
TTS_PUBLIC_BASE_PATH=/media/tts
# TTS fallback: /audio/speech (озвучка одного слова). Работает с OpenAI; для OpenRouter поддержка может отсутствовать.
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_REQUEST_TIMEOUT=45s
# Free pronunciation dictionary fallback (for single words)
TTS_DICTIONARY_ENABLED=true
TTS_DICTIONARY_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en
TTS_DICTIONARY_MIN_DELAY=100ms
# Опционально: свой текст user-сообщения для OpenRouter chat+audio TTS; плейсхолдер {word}
# TTS_CHAT_PRONUNCIATION_PROMPT=...
TTS_INTERNAL_ENABLED=false
TTS_INTERNAL_TOKENS_JSON=
TTS_INTERNAL_MAX_PENDING_LIMIT=500
TTS_INTERNAL_MAX_UPLOAD_MB=10
# Background prefetch/backfill behavior
TTS_PREFETCH_ENABLED=true
TTS_PREFETCH_WORKERS=2
TTS_BACKFILL_INTERVAL=10m
TTS_BACKFILL_BATCH_SIZE=200
TTS_RETRY_BASE_DELAY=1m
TTS_RETRY_MAX_DELAY=24h
TTS_MAX_RETRIES=8

# AI Prompt Configuration (choose one):
# Option 1: Direct prompt in .env (use \n for line breaks)
AI_PROMPT="You are a helpful AI assistant. You should:\n- Always be polite and respectful\n- Provide accurate information\n- Ask clarifying questions when needed\n- Keep responses concise but informative\n\nPlease respond to the user's message following these guidelines."

# Option 2: Load prompt from file (recommended for long prompts)
# AI_PROMPT_FILE=prompts/simple-assistant.txt

# Available prompt files:
# - prompts/simple-assistant.txt (basic helpful assistant)
# - prompts/customer-support.txt (customer support specialist)
# - prompts/teacher-ru-en.txt (RU→EN teacher, default profile)
# - prompts/teacher-ru-es.txt (RU→ES)
# - prompts/english-teacher.txt (same content as teacher-ru-en; legacy path)
# Teacher single-word JSON uses neutral keys (definition_native, example_target, gloss_native); legacy keys still work.

# Bot Messages Configuration
# Messages are now defined in internal/config/config.go as defaults
# You can still override them via environment variables if needed:
# BOT_START_MESSAGE='...'
# BOT_HELP_MESSAGE='...'
# BOT_UNKNOWN_COMMAND_MESSAGE='...'
# BOT_ERROR_MESSAGE='...'
# BOT_EMPTY_MESSAGE='...'

# === Training System Configuration ===

# Admin Notifications (get your ID via /get_id command in bot)
ADMIN_TELEGRAM_ID=

# DB Schema page: allow running SQL queries (only for admins; DROP/TRUNCATE/ALTER etc. are blocked)
# DB_QUERY_ACCESS=true

# Training Worker Configuration
TRAINING_WORKER_ENABLED=true
TRAINING_WORKER_INTERVAL=30s
TRAINING_WORKER_BATCH_SIZE=5
# Number of parallel workers for LLM requests (default: 4)
TRAINING_LLM_WORKERS=4

# Training Card Generator Prompt
TRAINING_PROMPT_FILE=prompts/training-card-ru-en.txt

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_AUTO_RESET_HOURS=24

# Training UI Configuration
# Delay between showing question and answer options (in milliseconds)
TRAINING_OPTIONS_DELAY_MS=5000
# Delay after wrong answer before showing next card (in seconds)
TRAINING_WRONG_ANSWER_DELAY_SECONDS=5

# === Web Application Configuration ===

# JWT Authentication Configuration
# Secret key for signing JWT tokens (REQUIRED for JWT authentication)
# Generate a strong random secret: openssl rand -hex 32
WEBAPP_JWT_SECRET=your_jwt_secret_key_here

# JWT Access Token TTL (Time To Live) in hours
# Default: 24 hours if not set
# Access tokens are short-lived and used for API requests
WEBAPP_JWT_TTL_HOURS=24

# JWT Refresh Token TTL (Time To Live) in hours
# Default: 720 hours (30 days) if not set
# Refresh tokens are long-lived and used to obtain new access tokens
WEBAPP_REFRESH_TTL_HOURS=720

# OTP Configuration
# Time-to-live for OTP codes in seconds (default: 300 = 5 minutes)
WEBAPP_OTP_TTL_SECONDS=300

# Public URL for web application (optional, for CORS and redirects)
# WEBAPP_PUBLIC_URL=https://your-domain.com
# Internal API token for complaints triage skill / fetch_reports.py (primary release variable)
COMPLAINTS_SERVICE_TOKEN=
# Prod URLs template (copy to secrets/complaints-prod.env): see env.example.complaints-prod
# COMPLAINTS_SERVICE_URL_EN=https://qantrix.ru
# COMPLAINTS_SERVICE_URL_ES=https://es.qantrix.ru
# Optional backward-compatible JSON map for internal service tokens
# WEBAPP_INTERNAL_SERVICE_TOKENS_JSON={"default":"same_token_value"}

# Vite Dev Server URL (for development mode only)
# Used when running with -tags=test build tag
# Default: http://localhost:5173
# WEBAPP_VITE_DEV_SERVER_URL=http://localhost:5173

# Rate Limiting Configuration (optional - uses safe defaults if not set)
# Limits are per window (default window: 1 minute)
# WEBAPP_RATE_LIMIT_AUTH_REQUEST_OTP_PER_IP=10
# WEBAPP_RATE_LIMIT_AUTH_REQUEST_OTP_PER_IP_USER=3
# WEBAPP_RATE_LIMIT_AUTH_OTP_PER_IP=20
# WEBAPP_RATE_LIMIT_AUTH_OTP_PER_IP_USER=5
# WEBAPP_RATE_LIMIT_AUTH_TELEGRAM_UNSAFE_PER_IP=30
# WEBAPP_RATE_LIMIT_AUTH_TELEGRAM_UNSAFE_PER_IP_USER=10
# WEBAPP_RATE_LIMIT_AUTH_TELEGRAM_PER_IP=60
# WEBAPP_RATE_LIMIT_AUTH_REFRESH_PER_IP=60
# WEBAPP_RATE_LIMIT_APP_API_PER_USER=300
# WEBAPP_RATE_LIMIT_APP_CHAT_PER_USER=60
# WEBAPP_RATE_LIMIT_WINDOW_MINUTES=1
# WEBAPP_RATE_LIMIT_BURST_MULTIPLIER=2
